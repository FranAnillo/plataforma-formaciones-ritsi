# Copia este archivo como .env. No confirmes .env ni secretos al repositorio.
MONGO_URL=mongodb://mongo:27017
DB_NAME=plataforma_formativa_ritsi
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_DAYS=7
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_JOIN_WINDOW_MINUTES=15

# Obligatoria para guardar enlaces de videollamada. Usa un secreto aleatorio de
# al menos 32 caracteres y gestionado fuera del repositorio.
MEETING_URL_ENCRYPTION_KEY=

# URL publica del backend, embebida durante la compilacion del frontend.
VITE_BACKEND_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Telegram (opcionales). El secreto del webhook debe ser aleatorio y debe
# coincidir con secret_token al registrar el webhook ante Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Google Calendar institucional (opcional). Si falta cualquier valor, la
# sincronizacion queda desactivada sin afectar a las sesiones.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
WORKER_POLL_SECONDS=2

# Puertos de escucha locales. Permiten levantar entornos aislados de smoke test.
MONGO_BIND_PORT=27017
BACKEND_BIND_PORT=8000
FRONTEND_BIND_PORT=3000

FORMATIONS_SHEET_ID=1JSRrepNNdQDl6zeroZPDKUJztLhSC3j6r7y2h_ND09c
AUTO_IMPORT_FORMATIONS=false
AUTO_IMPORT_UNIVERSITIES=false
