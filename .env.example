# Copia este archivo como .env. No confirmes .env ni secretos al repositorio.
MONGO_URL=mongodb://mongo:27017
DB_NAME=plataforma_formativa_ritsi
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_DAYS=7
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_JOIN_WINDOW_MINUTES=15

# Obligatoria para guardar enlaces de videollamada. Usa un secreto aleatorio de
# al menos 32 caracteres y gestionado fuera del repositorio.
MEETING_URL_ENCRYPTION_KEY=

# URL publica del backend, embebida durante la compilacion del frontend.
VITE_BACKEND_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Inicio de sesion con Google (SSO), independiente de Google Calendar.
# 1. En Google Auth Platform configura Branding y Audience. Si la app esta en
#    pruebas y es externa, agrega tus cuentas en Test users.
# 2. Crea un cliente OAuth de tipo "Aplicacion web" y registra EXACTAMENTE esta
#    URI de redireccion autorizada: http://localhost:8000/api/auth/google/callback
# 3. Pega aqui el ID de cliente y su secreto (no son una clave API).
#    Con ambos valores aparece "Continuar con Google". Vacios = desactivado.
# 4. Aplica los cambios con: docker compose up --build -d
# No necesitas refresh token ni habilitar Calendar para el SSO.
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
GOOGLE_SSO_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Opcional: limita a un dominio de Google Workspace, por ejemplo ritsi.org.
# Vacio permite Gmail y Workspace. Se valida el dominio certificado por Google.
GOOGLE_SSO_ALLOWED_DOMAIN=
# El SSO accede a cuentas activas YA registradas con el mismo correo.
# Conserva roles y universidad; no crea cuentas ni concede permisos.
# Para produccion cambia las URLs a HTTPS y usa COOKIE_SECURE=true.

# Telegram (opcionales). El secreto del webhook debe ser aleatorio y debe
# coincidir con secret_token al registrar el webhook ante Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Google Calendar institucional (opcional). Si falta cualquier valor, la
# sincronizacion queda desactivada sin afectar a las sesiones.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
WORKER_POLL_SECONDS=2

# Puertos de escucha locales. Permiten levantar entornos aislados de smoke test.
MONGO_BIND_PORT=27017
BACKEND_BIND_PORT=8000
FRONTEND_BIND_PORT=3000

FORMATIONS_SHEET_ID=1JSRrepNNdQDl6zeroZPDKUJztLhSC3j6r7y2h_ND09c
AUTO_IMPORT_FORMATIONS=false
AUTO_IMPORT_UNIVERSITIES=false
